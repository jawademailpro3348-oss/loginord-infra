---
# Liste des secrets attendus dans vault/secrets.yml (valeurs FACTICES).
# Créer / modifier le vrai fichier : ansible-vault edit vault/secrets.yml

# MC01 — connexions et comptes
vault_win_password: "MotDePasseAdministrateurWindows"
vault_linux_become_password: "MotDePasseSudoDuCompteAnsible"
vault_admin_password: "MotDePasseDuCompteSysadmin"   # complexe : exigé par Windows

# MC02 — clés privées WireGuard (wg genkey)
vault_wg_private_key:
  rtr-a: "cle_privee_rtr-a"
  rtr-b: "cle_privee_rtr-b"
